# Twilio Configuration
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+661234567890

# Backend Configuration
BACKEND_URL=
WEBSOCKET_URL=

# Audio Configuration
SAMPLE_RATE=48000  # Twilio uses 8kHz by default (mulaw)
AUDIO_CHANNELS=1
LANGUAGE=th-TH

# Storage Configuration
OUTPUT_DIR=output

# Optional: AWS S3 for recordings
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_REGION=us-east-1
